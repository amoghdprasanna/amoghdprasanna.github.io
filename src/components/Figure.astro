---
// A figure slot. Pass an image with <Figure src={img} alt="..." caption="..." />;
// without one it draws an empty plot frame so the page still reads well.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { caption: string; src?: ImageMetadata; alt?: string }
const { caption, src, alt = '' } = Astro.props;
---
<figure class="fig">
  {src ? (
    <Image src={src} alt={alt} widths={[480, 800, 1200]} sizes="(min-width: 52rem) 68ch, 100vw" />
  ) : (
    <div class="frame" role="img" aria-label="Figure in preparation">
      <svg viewBox="0 0 400 200" aria-hidden="true" preserveAspectRatio="none">
        <path d="M30 10V180H390" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke"/>
        <path d="M30 170C90 168 120 60 170 55S240 150 300 160 370 172 390 172" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="4 5" vector-effect="non-scaling-stroke"/>
      </svg>
      <span class="mono">figure in preparation</span>
    </div>
  )}
  <figcaption class="mono-plain">{caption}</figcaption>
</figure>
<style>
  .fig { margin-block: 1.6em; }
  .frame {
    position: relative; aspect-ratio: 2 / 1; border: 1px solid var(--line); border-radius: 4px;
    color: var(--faint); background: var(--bg-2); display: grid; place-items: center;
  }
  .frame svg { position: absolute; inset: 8% 6%; width: 88%; height: 84%; }
  .frame span { position: relative; background: var(--bg-2); padding: 0.2rem 0.5rem; }
  figcaption { margin-top: 0.6rem; font-size: var(--step--1); }
</style>
