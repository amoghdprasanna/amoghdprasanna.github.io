---
import Ink from './Ink.astro';
import Note from './Note.astro';
import { site } from '../site';

// Feynman diagrams drifting behind the sphere. Fermions are straight lines with
// an arrow, photons are wavy lines, vertices are dots.
type P = [number, number];
const wave = ([x0, y0]: P, [x1, y1]: P, n = 6, amp = 4) => {
  const dx = x1 - x0, dy = y1 - y0, L = Math.hypot(dx, dy), ux = dx / L, uy = dy / L;
  let d = `M${x0} ${y0}`;
  const steps = n * 8;
  for (let i = 1; i <= steps; i++) {
    const t = i / steps, s = Math.sin(t * n * Math.PI * 2) * amp;
    d += `L${(x0 + dx * t - uy * s).toFixed(1)} ${(y0 + dy * t + ux * s).toFixed(1)}`;
  }
  return d;
};
const fermion = ([x0, y0]: P, [x1, y1]: P) => {
  const mx = (x0 + x1) / 2, my = (y0 + y1) / 2, a = Math.atan2(y1 - y0, x1 - x0);
  const h = (da: number) => `${(mx - 7 * Math.cos(a + da)).toFixed(1)} ${(my - 7 * Math.sin(a + da)).toFixed(1)}`;
  return `M${x0} ${y0}L${x1} ${y1}M${h(0.5)}L${mx.toFixed(1)} ${my.toFixed(1)}L${h(-0.5)}`;
};
const diagrams = [
  { // Moller scattering: photon exchange between two electrons
    name: 'moller', f: [fermion([10, 10], [60, 40]), fermion([60, 40], [110, 10]), fermion([10, 130], [60, 100]), fermion([60, 100], [110, 130])],
    w: [wave([60, 40], [60, 100], 5)], v: [[60, 40], [60, 100]] as P[],
  },
  { // QED vertex
    name: 'vertex', f: [fermion([10, 20], [60, 70]), fermion([60, 70], [10, 120])],
    w: [wave([60, 70], [130, 70], 6)], v: [[60, 70]] as P[],
  },
  { // vacuum polarisation: a photon splits into a pair and recombines
    name: 'loop', f: [], w: [wave([5, 60], [45, 60], 3), wave([115, 60], [155, 60], 3)], v: [[45, 60], [115, 60]] as P[],
    loop: 'M45 60C45 25 115 25 115 60C115 95 45 95 45 60',
  },
  { // pair annihilation into two photons
    name: 'annihilation', f: [fermion([10, 10], [55, 50]), fermion([55, 90], [10, 130]), fermion([55, 50], [55, 90])],
    w: [wave([55, 50], [130, 15], 5), wave([55, 90], [130, 125], 5)], v: [[55, 50], [55, 90]] as P[],
  },
];
const gates = ['H', 'X', 'Y', 'Z', 'S', 'T'];
---

<div class="qubit-lab" data-bloch>
  <div class="feynman" aria-hidden="true">
    {diagrams.map((d, i) => (
      <svg class={`fd fd-${i}`} viewBox="0 0 160 140" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        {d.f.map((p) => <path d={p} />)}
        {d.w.map((p) => <path d={p} class="photon" />)}
        {d.loop && <path d={d.loop} />}
        {d.v.map(([x, y]) => <circle cx={x} cy={y} r="2.6" fill="currentColor" stroke="none" />)}
      </svg>
    ))}
  </div>

  <div class="stage">
    <canvas tabindex="0" aria-label="Bloch sphere of the qubit. Drag, or use the arrow keys, to turn it." role="img"></canvas>
    <p class="hint mono" aria-hidden="true">drag to turn</p>
  </div>

  <div class="panel">
    <p class="lede">
      One qubit, simulated in your browser. Apply gates, measure it, or turn up the noise and watch the state lose its purity: the Bloch vector shrinks toward the centre and the sphere comes apart.
    </p>

    <div class="gates" role="group" aria-label="Gates">
      {gates.map((g) => <button class="btn gate" type="button" data-gate={g} aria-label={`Apply ${g} gate`}>{g}</button>)}
      <button class="btn gate wide" type="button" data-gate="M">measure</button>
      <button class="btn gate wide" type="button" data-gate="R">reset</button>
    </div>

    <label class="noise">
      <span class="mono">noise (T₁, T₂)</span>
      <input type="range" min="0" max="100" value="0" step="1" data-noise aria-valuetext="off" />
    </label>

    <dl class="readout mono-plain">
      <div><dt>state</dt><dd data-out="state">|0⟩</dd></div>
      <div><dt>P(0)</dt><dd data-out="p0">1.00</dd></div>
      <div><dt>Tr ρ²</dt><dd data-out="purity">1.00</dd></div>
      <div><dt>|coherence|</dt><dd data-out="coh">0.00</dd></div>
    </dl>
    <p class="last mono" data-out="last" aria-hidden="true"></p>
    <p class="visually-hidden" role="status" aria-live="polite" data-out="live"></p>

    <div class="purity">
      <Ink name="eq-purity" class="eq" label="Handwritten: trace of rho A squared equals 1, the condition for a pure state." />
      <Note>pure, until the noise arrives</Note>
    </div>

    <p class="real">
      There is also a real shared qubit on my GitHub profile: everyone who visits acts on the same state.
      <a class="more" href={site.links.qubitGate('H')}>Apply H to it</a>
    </p>
  </div>
</div>

<script>
  import { mountBloch } from '../scripts/bloch';
  const el = document.querySelector<HTMLElement>('[data-bloch]');
  if (el) {
    // Start the simulation when the section nears the viewport, or on the first
    // interaction, whichever comes first.
    let mounted = false;
    const mount = () => { if (!mounted) { mounted = true; io.disconnect(); mountBloch(el); } };
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) mount(); }, { rootMargin: '400px' });
    io.observe(el);
    el.addEventListener('pointerdown', mount, { capture: true, once: true });
    el.addEventListener('focusin', mount, { once: true });
  }
</script>

<style>
  .qubit-lab {
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-l); align-items: start;
  }
  .feynman { position: absolute; inset: -2rem 50% -2rem -1rem; pointer-events: none; color: var(--mute); overflow: hidden; z-index: 0; }
  .fd { position: absolute; width: clamp(5rem, 9vw, 8rem); opacity: 0.16; }
  .fd .photon { stroke: var(--accent); }
  .fd-0 { left: 0; top: 2%; }
  .fd-1 { right: 0; top: 6%; }
  .fd-2 { left: 4%; bottom: 2%; }
  .fd-3 { right: 2%; bottom: 6%; }
  @media (prefers-reduced-motion: no-preference) {
    .fd { animation: drift 46s ease-in-out infinite alternate; }
    .fd-1 { animation-duration: 58s; animation-delay: -12s; }
    .fd-2 { animation-duration: 52s; animation-delay: -20s; }
    .fd-3 { animation-duration: 64s; animation-delay: -8s; }
  }
  @keyframes drift {
    0% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(1.5rem, -1rem) rotate(6deg); }
    100% { transform: translate(-1rem, 1.2rem) rotate(-5deg); }
  }

  .stage { position: relative; z-index: 1; }
  canvas { width: 100%; aspect-ratio: 1; cursor: grab; touch-action: none; border-radius: 50%; }
  canvas:active { cursor: grabbing; }
  .hint { text-align: center; margin-top: -0.5rem; }
  .panel { position: relative; z-index: 1; display: grid; gap: 1.2rem; }
  .lede { color: var(--mute); max-width: 46ch; }
  .gates { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .gate { min-width: 2.75rem; min-height: 2.75rem; font-size: var(--step--1); }
  .gate.wide { padding-inline: 0.9rem; }
  .noise { display: grid; gap: 0.4rem; max-width: 22rem; }
  input[type='range'] { accent-color: var(--accent); width: 100%; min-height: 2rem; }
  .readout { display: grid; grid-template-columns: repeat(4, auto); gap: 0.4rem 1.4rem; justify-content: start; }
  .readout dt { font-size: var(--step--2); text-transform: uppercase; letter-spacing: 0.06em; }
  .readout dd { color: var(--fg); font-variant-numeric: tabular-nums; margin-top: 0.15rem; }
  .last { min-height: 1.2em; }
  .purity { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .purity :global(.eq) { width: 12.5rem; }
  .real { color: var(--mute); max-width: 46ch; }
  .real .more { margin-top: 0.4rem; }

  @media (max-width: 52rem) {
    .qubit-lab { grid-template-columns: minmax(0, 1fr); }
    .feynman { inset: -1rem -0.5rem auto; height: min(26rem, 100vw); }
    .stage { max-width: 24rem; margin-inline: auto; width: 100%; }
    .readout { grid-template-columns: repeat(2, auto); }
  }
</style>
