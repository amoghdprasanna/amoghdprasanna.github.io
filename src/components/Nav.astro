---
const items = [
  { href: '/#research', label: 'Research' },
  { href: '/#publications', label: 'Publications' },
  { href: '/#software', label: 'Software' },
  { href: '/readings/', label: 'Readings' },
  { href: '/cv/', label: 'CV' },
];
const path = Astro.url.pathname;
// Pages get aria-current="page". Homepage sections are marked "location" by the
// scroll-spy below as they pass under the header; project pages belong to Research.
const current = (href: string) =>
  href === path ? 'page' : href === '/#research' && path.startsWith('/research/') ? 'true' : undefined;
---

<header class="site-header">
  <nav class="site wrap" aria-label="Primary">
    <a class="me mono" href="/" aria-label="Amogh D. Prasanna, home"><i aria-hidden="true"></i>Amogh D. Prasanna</a>
    <ul class="links mono">
      {items.map((i) => (
        <li><a href={i.href} aria-current={current(i.href)} data-spy={i.href.startsWith('/#') ? i.href.slice(2) : undefined}>{i.label}</a></li>
      ))}
    </ul>
    <button class="theme mono" type="button" aria-label="Switch to light theme" data-theme-toggle>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"/></svg>
      <span data-theme-label>dark</span>
    </button>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const label = btn.querySelector('[data-theme-label]')!;
  const root = document.documentElement;
  const mq = matchMedia('(prefers-color-scheme: light)');
  const stored = () => { try { return localStorage.getItem('theme'); } catch { return null; } };
  const current = () => (root.dataset.theme === 'light' ? 'light' : 'dark');
  // Base.astro resolves the theme before first paint; this keeps it in sync.
  const apply = (t: 'light' | 'dark') => {
    root.dataset.theme = t;
    document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((m) => { m.content = m.dataset[t]!; });
    label.textContent = t;
    btn.setAttribute('aria-label', `Switch to ${t === 'dark' ? 'light' : 'dark'} theme`);
    document.dispatchEvent(new CustomEvent('themechange'));
  };
  btn.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem('theme', next); } catch {}
    apply(next);
  });
  // Follow the system only until the visitor has picked a theme.
  mq.addEventListener('change', () => { if (!stored()) apply(mq.matches ? 'light' : 'dark'); });
  label.textContent = current();
  btn.setAttribute('aria-label', `Switch to ${current() === 'dark' ? 'light' : 'dark'} theme`);

  // Scroll-spy for homepage sections: the section crossing a line just below the
  // header is "current"; sections without a nav link clear the highlight.
  const spy = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  const sections = location.pathname === '/' ? [...document.querySelectorAll<HTMLElement>('main section[id]')] : [];
  if (spy.length && sections.length) {
    const mark = (id: string | null) => spy.forEach((a) => {
      if (a.dataset.spy === id) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current');
    });
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) mark(e.target.id);
    }, { rootMargin: '-20% 0px -79% 0px' });
    sections.forEach((s) => io.observe(s));
    // Above the first section (the hero), nothing is current.
    const top = sections[0];
    addEventListener('scroll', () => { if (top.getBoundingClientRect().top > innerHeight * 0.2) mark(null); }, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  nav {
    display: flex; align-items: center; gap: 1.5rem; min-height: 3.5rem;
  }
  .me { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--fg); text-decoration: none; white-space: nowrap; margin-right: auto; }
  .me i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); }
  .links { display: flex; gap: clamp(0.9rem, 2vw, 1.6rem); list-style: none; padding: 0; }
  .links a { text-decoration: none; padding-block: 0.6rem; }
  .links a:hover, .links a[aria-current] { color: var(--fg); }
  .links a[aria-current] { box-shadow: inset 0 -1px var(--accent); }
  .theme {
    display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer;
    background: none; border: 1px solid var(--line); border-radius: 99px;
    padding: 0.35rem 0.7rem; min-height: 2rem;
  }
  .theme:hover { color: var(--fg); border-color: var(--faint); }

  @media (max-width: 40rem) {
    nav { flex-wrap: wrap; gap: 0 1rem; padding-block: 0.3rem; }
    .links {
      order: 3; width: 100%; overflow-x: auto; scrollbar-width: none;
      gap: 1.1rem; border-top: 1px solid var(--line);
    }
    .links::-webkit-scrollbar { display: none; }
  }
  /* Below ~384px the links no longer fit: fade the right edge so the row reads
     as scrollable, with end padding so the last link can scroll clear of it. */
  @media (max-width: 24rem) {
    .links {
      padding-inline-end: 2rem;
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
    }
    .theme span { display: none; }
  }
</style>
