---
// One of my handwritten equations, lifted from my notes as vector strokes
// (see tools/ink). Inlined so it takes the theme colour and draws itself in.
interface Props { name: string; label: string; class?: string; draw?: boolean }
const { name, label, class: cls = '', draw = true } = Astro.props;
const files = import.meta.glob<string>('../assets/ink/*.svg', { query: '?raw', import: 'default', eager: true });
const raw = files[`../assets/ink/${name}.svg`];
if (!raw) throw new Error(`No ink named ${name}`);
const svg = raw
  .replace('<svg ', `<svg role="img" aria-label="${label.replace(/"/g, '&quot;')}" `)
  .replaceAll('<path ', '<path pathLength="1" ');
---
<div class:list={['ink', { draw }, cls]} set:html={svg} />
