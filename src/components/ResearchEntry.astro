---
import type { CollectionEntry } from 'astro:content';
import Ink from './Ink.astro';
import Note from './Note.astro';
import { handFor } from '../data/hand';
interface Props { entry: CollectionEntry<'research'> }
const { entry } = Astro.props;
const d = entry.data;
const href = `/research/${entry.id}/`;
const capInk = d.inkLabel && handFor(d.inkLabel);
---
<article class="entry reveal">
  <p class="meta mono">{d.year} · {d.place}{d.collaborators.length > 0 && ` · with ${d.collaborators.map((c) => c.replace(/ \(.*\)$/, '')).join(', ')}`}</p>
  <div class="main">
    <h3><a href={href} style={`view-transition-name: q-${entry.id}`}>{d.question}</a></h3>
    <p class="summary">{d.summary}</p>
    <ul class="tags" aria-label="Methods and tools">{d.tags.map((t) => <li class="tag">{t}</li>)}</ul>
    <a class="more" href={href}>Read more<span class="visually-hidden">: {d.question}</span></a>
  </div>
  <div class="aside">
    {d.metric ? (
      <p class="metric"><b>{d.metric.value}</b><span class="mono">{d.metric.label}</span></p>
    ) : (
      <span class="chip">{d.status}</span>
    )}
    {d.metric && <span class="chip">{d.status}</span>}
    {d.ink && <Ink name={d.ink} label={d.inkAlt ?? `Handwritten, ${d.inkLabel ?? 'from my notes'}`} class="eq" scale={0.07} />}
    {d.ink && d.inkLabel && (capInk
      ? <Ink name={capInk} label={d.inkLabel} class="ink-cap-hand" scale={0.055} />
      : <p class="ink-cap mono-plain">{d.inkLabel}</p>)}
  </div>
  {d.note && <Note class="margin">{d.note}</Note>}
</article>

<style>
  .entry {
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(9rem, 15rem);
    gap: 0.4rem var(--space-l); padding-block: var(--space-m) var(--space-l);
    border-bottom: 1px solid var(--line);
  }
  .entry:first-of-type { padding-top: 0; }
  .meta { grid-column: 1 / -1; }
  h3 { font-size: var(--step-2); font-weight: 600; line-height: 1.2; letter-spacing: -0.012em; max-width: 30ch; text-wrap: balance; }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-color: var(--accent); }
  .summary { color: var(--mute); max-width: 62ch; margin-top: 0.7rem; text-wrap: pretty; }
  .tags { margin-top: 1rem; }
  .more { margin-top: 1rem; }
  .aside { display: grid; gap: 0.7rem; justify-items: end; align-content: start; text-align: right; }
  .metric b { display: block; font: 400 clamp(2.4rem, 2rem + 1.8vw, 3.4rem) / 1 var(--serif); font-variant-numeric: lining-nums; }
  .metric span { display: block; margin-top: 0.5rem; max-width: 24ch; margin-left: auto; line-height: 1.5; }
  .aside :global(.eq) { max-width: 100%; margin-top: 0.6rem; }
  .aside :global(.ink-cap-hand) { max-width: 100%; color: var(--accent); margin-top: -0.2rem; }
  .ink-cap { font-size: var(--step--2); max-width: 22ch; }
  .entry :global(.margin) {
    position: absolute; left: calc(-1 * var(--label-col) - var(--space-l) + 0.5rem); top: 4.2rem;
    width: calc(var(--label-col) - 1rem); transform: rotate(-3deg);
  }
  @media (max-width: 52rem) {
    .entry { grid-template-columns: minmax(0, 1fr); }
    .aside { justify-items: start; text-align: left; grid-template-columns: auto auto; align-items: end; justify-content: start; gap: 0.5rem 1rem; }
    .metric span { margin-left: 0; }
    .aside :global(.eq), .aside :global(.ink-cap-hand), .ink-cap { grid-column: 1 / -1; }
    .entry :global(.margin) { position: static; transform: rotate(-1.5deg); width: auto; margin-top: 0.4rem; }
  }
</style>
