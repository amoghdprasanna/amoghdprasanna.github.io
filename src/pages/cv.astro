---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Publication from '../components/Publication.astro';
import { site } from '../site';
import { education, research, coursework, schools, industry, awards, skills } from '../data/cv';

const pubs = (await getCollection('publications', (e) => !e.data.draft)).sort((a, b) => a.data.order - b.data.order);
const updated = 'October 2026';
---

<Base title="CV" description={`Curriculum vitae of ${site.name}.`}>
  <article class="wrap cv">
    <header>
      <p class="crumb mono"><a href="/">← Home</a></p>
      <h1>{site.fullName}</h1>
      <p class="contact mono-plain">
        {site.role}, {site.affiliation} · <a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.links.github}>GitHub</a> · <a href={site.links.linkedin}>LinkedIn</a>
      </p>
      <p class="actions"><a class="btn" href={site.links.cv} download>Download PDF</a> <button class="btn no-print" type="button" onclick="window.print()">Print this page</button></p>
      <p class="mono updated">Updated {updated}</p>
    </header>

    <section>
      <h2 class="mono">Education</h2>
      {education.map((e) => (
        <div class="item">
          <div class="head"><strong>{e.school}</strong><span class="mono-plain">{e.dates}</span></div>
          <p><i>{e.degree}</i>, {e.detail}. {e.place}.</p>
        </div>
      ))}
    </section>

    <section>
      <h2 class="mono">Research experience</h2>
      {research.map((r) => (
        <div class="item">
          <div class="head"><strong>{r.org}</strong><span class="mono-plain">{r.dates}</span></div>
          <p><i>{r.role}</i></p>
          <ul>{r.points.map((p) => <li>{p}</li>)}</ul>
        </div>
      ))}
    </section>

    <section>
      <h2 class="mono">Publications</h2>
      {pubs.map((p) => <Publication entry={p} />)}
    </section>

    <section>
      <h2 class="mono">Graduate coursework</h2>
      <ul class="plain">{coursework.map((c) => <li><span class="mono-plain">{c.code}</span> {c.title} ({c.who}{c.note && `, ${c.note}`})</li>)}</ul>
      <h3 class="mono">Schools</h3>
      <ul class="plain">{schools.map((s) => <li>{s.title}, {s.year}</li>)}</ul>
    </section>

    <section>
      <h2 class="mono">Industry</h2>
      {industry.map((j) => (
        <div class="item">
          <div class="head"><strong>{j.org}</strong><span class="mono-plain">{j.dates}</span></div>
          <p><i>{j.role}</i>, {j.place}</p>
          <ul>{j.points.map((p) => <li>{p}</li>)}</ul>
        </div>
      ))}
    </section>

    <section>
      <h2 class="mono">Skills</h2>
      <dl class="skills">{skills.map((s) => <div><dt>{s.area}</dt><dd>{s.items}</dd></div>)}</dl>
    </section>

    <section>
      <h2 class="mono">Awards</h2>
      <ul class="plain">{awards.map((a) => <li>{a}</li>)}</ul>
    </section>
  </article>
</Base>

<style>
  .cv { max-width: 52rem; padding-block: var(--space-l) var(--space-xl); }
  .crumb a { text-decoration: none; }
  h1 { font-size: var(--step-3); font-weight: 500; letter-spacing: -0.02em; margin-top: var(--space-m); }
  .contact { margin-top: 0.6rem; line-height: 1.8; }
  .actions { margin-top: 1.2rem; display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .actions a.btn { text-decoration: none; display: inline-flex; align-items: center; }
  .updated { margin-top: 1rem; }
  section { margin-top: var(--space-l); }
  h2 { border-bottom: 1px solid var(--line); padding-bottom: 0.5rem; margin-bottom: 0.4rem; }
  h3 { margin-top: 1.2rem; }
  .item { padding-block: 0.9rem; }
  .head { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; align-items: baseline; }
  .item p { color: var(--mute); }
  ul { margin-top: 0.4rem; padding-left: 1.1rem; }
  li { margin-top: 0.35rem; }
  li::marker { color: var(--accent); }
  .plain { list-style: none; padding: 0; }
  .skills div { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: 1rem; padding-block: 0.4rem; }
  .skills dt { font-weight: 600; }
  .skills dd { color: var(--mute); }
  @media (max-width: 40rem) { .skills div { grid-template-columns: minmax(0, 1fr); gap: 0; } }
  @media print {
    .crumb, .actions, .updated { display: none; }
    .cv { padding: 0; max-width: none; }
    section { margin-top: 10pt; }
  }
</style>
